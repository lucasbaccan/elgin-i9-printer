#!/sbin/openrc-run
# Elgin I9 thermal printer — serviço OpenRC (Alpine Linux).
# Config opcional em /etc/conf.d/elgin-print:
#   ELGIN_LP=/dev/usb/lp0
#   ELGIN_API_PORT=8000
#   ELGIN_DATA_DIR=/var/lib/elgin-print   (imagens compartilhadas, validade de 7 dias)

name="elgin-print"
description="Elgin I9 thermal printer service (Go binary)"

command="/usr/local/bin/elgin-print"
command_args="serve"
command_background=true
pidfile="/run/${name}.pid"
output_log="/var/log/${name}.log"
error_log="/var/log/${name}.log"

# O openrc-run lê /etc/conf.d/elgin-print, mas as variáveis ficam só no shell do
# script: sem `export` o binário não as vê (getenv vazio -> valem os padrões do
# código e as imagens compartilhadas iriam para ./data, relativo ao cwd — que no
# OpenRC é /). Pasta de dados com o mesmo padrão do systemd (StateDirectory).
: "${ELGIN_DATA_DIR:=/var/lib/elgin-print}"
export ELGIN_LP ELGIN_API_PORT ELGIN_DATA_DIR ELGIN_IMG_MAX_MB ELGIN_LINE_DELAY_MS

depend() {
    need localmount
    after bootmisc
}
