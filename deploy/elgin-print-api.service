[Unit]
Description=Elgin I9 Print API (impressora termica via USB)
After=multi-user.target

[Service]
Type=simple
User=root
Environment=ELGIN_LP=/dev/usb/lp0
Environment=ELGIN_API_PORT=8000
ExecStart=/usr/local/bin/uvicorn main:app --host 0.0.0.0 --port 8000
WorkingDirectory=/opt/elgin-i9-printer/api
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
